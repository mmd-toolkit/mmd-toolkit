+// Patched from changesets/changesets#2382 (issue #2364): `git log --follow`
+// compares each changeset with every file of the parent trees, which on git 2.56
+// takes about 290 MB a lookup in this repository, and the lookups run in
+// parallel, one for each changeset. Find the add with renames off, then look for
+// a rename only in that commit, in the directory of the file.
+async function getCommitThatAddsFile(gitPath, { cwd, short, from = "HEAD", seen = /* @__PURE__ */ new Set() }) {
+	const [commitSha, parentSha] = (await exec("git", [
+		"log",
+		from,
+		"--diff-filter=A",
+		"--no-renames",
+		"--max-count=1",
+		short ? "--pretty=format:%h:%p" : "--pretty=format:%H:%p",
+		"--",
+		gitPath
+	], { nodeOptions: { cwd } })).stdout.toString().split(":");
+	const info = {
+		path: gitPath,
+		commitSha,
+		parentSha
+	};
+	if (!commitSha || !parentSha || seen.has(gitPath)) return info;
+	seen.add(gitPath);
+	const parent = parentSha.split(" ")[0];
+	const renameSource = (await exec("git", [
+		"diff",
+		"--name-status",
+		"-M",
+		"--diff-filter=R",
+		parent,
+		commitSha,
+		"--",
+		path.posix.dirname(gitPath)
+	], { nodeOptions: { cwd } })).stdout.toString().split("\n").map((line) => line.split("\t")).find(([, , to]) => to === gitPath)?.[1];
+	if (!renameSource) return info;
+	const earlier = await getCommitThatAddsFile(renameSource, {
+		cwd,
+		short,
+		from: parent,
+		seen
+	});
+	return earlier.commitSha ? {
+		...earlier,
+		path: gitPath
+	} : info;
