  2 | Person(a, "A")
  3 | UpdateElementStyle(a, $BgColor="red", $FontColor="white", $BorderColor="black")
    |                        ^~~~~~~ [1]     ^~~~~~~~~ [2]       ^~~~~~~~~~~ [3]
