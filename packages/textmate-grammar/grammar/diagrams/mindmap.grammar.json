{
  "patterns": [
    {
      "include": "#mindmap"
    }
  ],
  "repository": {
    "mindmap": {
      "comment": "Read mindmap at its header word boundary and keep subsequent lines in the mindmap context. Follows detection.md#the-detectors and mindmap.md#detection.",
      "begin": "{{diagramStart}}(mindmap){{wordEnd}}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Read a percent-pair comment where the statement context begins a unit, retaining directives in its mark and body. Follows mindmap.md#comments.",
          "match": "({{mindmap-comment-padding}})({{nonDirectivePercentPair}}(?:{{directive}}|(?!{{directiveStart}})[^\\r\\n{{separators}}])*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            },
            "2": {
              "name": "comment.line.percentage.mermaid",
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          }
        },
        {
          "comment": "Read the class marker and the following class name. Follows mindmap.md#the-statement-context and mindmap.md#the-icon-and-class-contexts.",
          "begin": "{{mindmap-statement-start}}(:::)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.separator.class.mermaid"
            }
          },
          "end": "(?=[{{separators}}]|$)",
          "contentName": "variable.mermaid",
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            }
          ]
        },
        {
          "comment": "Read the icon form only with its opening parenthesis, giving the marker, brackets and retained name their own scopes. Follows mindmap.md#the-icon-and-class-contexts.",
          "begin": "{{mindmap-statement-start}}((?i:::icon))(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.mermaid"
            },
            "2": {
              "name": "keyword.operator.bracket.icon.begin.mermaid"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.bracket.icon.end.mermaid"
            }
          },
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            },
            {
              "comment": "Runs stop before separator-led common comments, and padding never consumes their separator. Follows mindmap.md#the-icon-and-class-contexts and common.md#comment-lines.",
              "match": "(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^)])+",
              "name": "string.unquoted.mermaid",
              "captures": {
                "0": {
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "comment": "Read a mindmap shape with its parenthesis, brace or square-bracket opener and any accepted shape closer. The opener may include a dash. Only a quote at the initial value position starts a string; later quotes and HTML-looking content remain shape text. Follows mindmap.md#the-statement-context and mindmap.md#the-shape-context.",
          "begin": "[{{ws}}]*(-\\)|\\(-|\\)\\)|\\)|\\(\\(|\\{\\{|\\(|\\[)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.shape.begin.mermaid"
            }
          },
          "end": "(\\)\\)|\\)|\\]|\\}\\}|\\(-|-\\)|\\(\\(|\\()",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.shape.end.mermaid"
            }
          },
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            },
            {
              "comment": "A quote and backtick start a markdown string, closed by backtick and quote. Follows mindmap.md#the-shape-context.",
              "include": "#markdown-string"
            },
            {
              "comment": "A double quote starts a string ending at the next double quote, without escapes. Follows mindmap.md#the-shape-context.",
              "include": "#string-plain-double"
            },
            {
              "comment": "Read ordinary shape content until a parenthesis, closing square bracket or closing brace. Later quotes, percent pairs and opening brackets remain text. Follows mindmap.md#the-shape-context.",
              "begin": "(?=[^)\\](}])",
              "end": "(?=[)\\](}])",
              "patterns": [
                {
                  "include": "#comment-line"
                },
                {
                  "include": "#directive"
                },
                {
                  "comment": "Runs stop before separator-led common comments, and padding never consumes their separator. Follows mindmap.md#the-shape-context and common.md#comment-lines.",
                  "match": "(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^)\\](}])+",
                  "name": "string.unquoted.mermaid",
                  "captures": {
                    "0": {
                      "patterns": [
                        {
                          "include": "#directive"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "comment": "Read node text before its shape at a statement start, including after a directive. Follows mindmap.md#the-statement-context and common.md#a-directive-is-a-token-boundary.",
          "begin": "({{mindmap-statement-start}})(?![{{ws}}]|{{directiveStart}})(?=(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^(\\[){}\\r\\n])+[({\\[)])",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          },
          "end": "(?=[(\\[){}\\r\\n])|{{lineValueEnd}}",
          "contentName": "variable.mermaid",
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            }
          ]
        },
        {
          "comment": "Read a bare node label after indentation or a directive, requiring text outside directives and whitespace. Follows mindmap.md#directives-inside-units and mindmap.md#the-statement-context.",
          "begin": "{{mindmap-statement-start}}(?![{{ws}}]|{{directiveStart}})(?=[^(\\[){}\\r\\n])",
          "end": "{{lineValueEnd}}|(?=[(\\[){}\\r\\n])",
          "contentName": "string.unquoted.mermaid",
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            }
          ]
        }
      ]
    }
  },
  "variables": {
    "mindmap-statement-start": "(?:^|\\G|{{afterDirectiveEnd}}|(?<=[{{separators}}]))(?:(?!{{separatorCommentEnd}})[{{ws}}])*",
    "mindmap-comment-padding": "(?:(?!{{separatorCommentEnd}})(?:[{{lws}}]|{{directive}}))*"
  }
}
