{
  "patterns": [
    {
      "include": "#sankey"
    }
  ],
  "repository": {
    "sankey": {
      "comment": "Begin sankey at its lowercase detector prefix, accepting either bounded beta spelling. Follows sankey.md#detection and common.md#leading-whitespace.",
      "begin": "{{diagramStart}}(sankey(?:-(?i:beta))?){{wordEnd}}",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Track the three fields of each record, retaining that position across multiline strings. Follows sankey.md#diagram-and-records and sankey.md#ids-and-values.",
          "begin": "(?!{{separatorCommentEnd}})(?=.)",
          "end": "{{lineValueEnd}}",
          "patterns": [
            {
              "include": "#comment-line"
            },
            {
              "include": "#directive"
            },
            {
              "comment": "After the first comma, read the target and then the value field. Follows sankey.md#diagram-and-records.",
              "begin": ",",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.separator.comma.mermaid"
                }
              },
              "end": "{{lineValueEnd}}",
              "patterns": [
                {
                  "include": "#comment-line"
                },
                {
                  "include": "#directive"
                },
                {
                  "comment": "After the second comma, read the link value rather than an element name. Follows sankey.md#ids-and-values.",
                  "begin": ",",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.separator.comma.mermaid"
                    }
                  },
                  "end": "{{lineValueEnd}}",
                  "patterns": [
                    {
                      "include": "#comment-line"
                    },
                    {
                      "include": "#directive"
                    },
                    {
                      "include": "#sankey-string"
                    },
                    {
                      "include": "#sankey-value"
                    }
                  ]
                },
                {
                  "include": "#sankey-string"
                },
                {
                  "include": "#sankey-name"
                }
              ]
            },
            {
              "include": "#sankey-string"
            },
            {
              "include": "#sankey-name"
            }
          ]
        }
      ]
    },
    "sankey-html-tag": {
      "comment": "Reuse shared HTML tag parts; paired quotes crossing the tag end or a common comment remain available to the surrounding CSV string. Follows common.md#html-attribute-quotes, sankey.md#strings, common.md#a-directive-is-a-token-boundary, and common.md#comment-lines.",
      "match": "{{htmlTagStart}}(?:{{htmlQuotedValue}}|{{htmlTagDirective}}|{{sankey-html-doubled-quote}}|{{htmlTagCharacter}})*(?:{{htmlTagEnd}}|(?=\")|{{separatorCommentEnd}})",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#directive"
            }
          ]
        }
      }
    },
    "sankey-string": {
      "comment": "Read CSV quoted strings with doubled quotes and multiline content. Follows sankey.md#strings.",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "string.quoted.double.mermaid punctuation.definition.string.begin.mermaid"
        }
      },
      "end": "{{sankey-string-end}}",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.mermaid punctuation.definition.string.end.mermaid"
        }
      },
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Read quoted content while leaving common-comment boundaries to the enclosing context. Follows sankey.md#strings and common.md#comment-lines.",
          "begin": "(?!{{separatorCommentEnd}})(?=.)",
          "end": "(?={{sankey-string-end}})|{{separatorCommentEnd}}",
          "contentName": "string.quoted.double.mermaid",
          "patterns": [
            {
              "include": "#directive"
            },
            {
              "comment": "Reuse shared HTML parts while protecting doubled quotes. Follows sankey.md#lexical-structure.",
              "include": "#sankey-html-tag"
            },
            {
              "match": "{{sankey-doubled-quote}}",
              "name": "constant.character.escape.mermaid",
              "comment": "Read doubled quotes as a string escape, including directives between their characters. Follows sankey.md#strings and common.md#a-directive-is-a-token-boundary.",
              "captures": {
                "1": {
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "sankey-name": {
      "comment": "Read an unquoted source or target id as an element name, retaining authored HTML quote text inside the field. Follows sankey.md#ids-and-values, sankey.md#the-record-context, and common.md#comment-lines.",
      "begin": "{{sankey-field-start}}",
      "end": "{{sankey-field-end}}",
      "patterns": [
        {
          "include": "#directive"
        }
      ],
      "contentName": "variable.mermaid"
    },
    "sankey-value": {
      "comment": "Read an unquoted link value as text, even when its spelling looks numeric. Follows sankey.md#ids-and-values and common.md#comment-lines.",
      "begin": "{{sankey-field-start}}",
      "end": "{{sankey-field-end}}",
      "patterns": [
        {
          "include": "#directive"
        }
      ],
      "contentName": "string.unquoted.mermaid"
    }
  },
  "variables": {
    "sankey-field-start": "(?!{{separatorCommentEnd}})(?=[^\",\\r\\n])",
    "sankey-field-end": "(?=,)|{{lineValueEnd}}",
    "sankey-doubled-quote": "\"({{directives}})\"",
    "sankey-html-doubled-quote": "\"(?:{{htmlTagDirective}})*\"",
    "sankey-string-end": "(?!{{sankey-doubled-quote}})\""
  }
}
