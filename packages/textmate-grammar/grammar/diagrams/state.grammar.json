            }
          ]
        },
        "11": {
          "patterns": [
            {
              "include": "#state-direction-text"
            }
          ]
        },
        "12": {
          "name": "keyword.control.mermaid"
        },
        "13": {
          "patterns": [
            {
              "include": "#directive"
            }
          ]
        },
        "14": {
          "name": "constant.language.mermaid"
        },
        "15": {
          "patterns": [
            {
              "include": "#state-direction-text"
            }
          ]
        },
        "16": {
