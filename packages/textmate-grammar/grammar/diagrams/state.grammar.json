              "include": "#directive"
            },
            {
              "include": "#state-comma"
            }
          ]
        },
        "8": {
          "patterns": [
            {
              "include": "#directive"
            }
          ]
        }
      },
      "end": "{{lineValueEnd}}",
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Read a style property name before its colon. Follows state.md#the-classdef-class-and-style-contexts.",
          "match": "(?:{{entity}}|{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^,:\\r\\n])+(?=:)",
          "captures": {
            "0": {
              "name": "support.type.property-name.mermaid",
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          }
        },
        {
          "comment": "Read one whole style property value, leaving trailing whitespace outside its scope. Follows state.md#the-classdef-class-and-style-contexts.",
          "begin": "(:)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.key-value.mermaid"
            }
          },
          "end": "{{state-style-value-end}}",
          "contentName": "support.constant.property-value.mermaid",
          "patterns": [
            {
              "include": "#directive"
            }
          ]
        },
        {
          "include": "#state-comma"
        },
        {
          "comment": "Read a whole style without a property colon as one value, leaving trailing whitespace outside it. Follows state.md#the-classdef-class-and-style-contexts.",
          "begin": "(?![{{ws}}]|[:,]|{{directiveStart}}|{{separatorCommentEnd}})(?=.)",
          "end": "{{state-style-value-end}}",
          "contentName": "support.constant.property-value.mermaid",
          "patterns": [
            {
              "include": "#directive"
            },
            {
              "include": "#entity"
            }
          ]
        }
      ]
    },
    "state-class": {
      "comment": "Class reads word ids separated by commas followed by optional whitespace, then the rest of the line as one css-class text, which can contain spaces and keywords. Follows state.md#the-classdef-class-and-style-contexts.",
      "begin": "((?i:class))({{state-required-padding}})({{state-word}}(?:{{directives}},{{state-value-padding}}{{state-word}})*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
