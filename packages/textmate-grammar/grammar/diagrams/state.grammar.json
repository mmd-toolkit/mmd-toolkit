    "state-string": {
      "patterns": [
        {
          "comment": "A double quote starts a string ending at the next double quote, with no escape mechanism. Follows state.md#the-statement-context.",
          "include": "#string-plain-double"
        }
      ]
    },
    "state-comments": {
      "comment": "Hash and percent-percent not followed by { start comments only at unit starts; ids consume an internal hash and end before an internal percent pair. Entities do not start hash comments. Native comment text ends before a separator-led common comment; neither percent of its mark may belong to a directive. Follows state.md#comments and common.md#comment-lines.",
      "patterns": [
        {
          "comment": "An entity is converted before lexical reading and cannot start a hash comment. Follows state.md#comments.",
          "include": "#entity"
        },
        {
          "comment": "Read the ignored percent pair directly before a composite body opener. Follows state.md#the-statement-context and state.md#composite-states-aliases-and-pseudostates.",
          "match": "{{nonDirectivePercentPair}}(?={{directives}}\\{)",
          "name": "comment.block.ignored.mermaid",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          }
        },
        {
          "comment": "Rule 8: hash and the rest of the line are a diagram comment. Follows state.md#the-statement-context.",
          "name": "comment.line.number-sign.mermaid",
          "match": "#(?:{{directive}}|(?!{{directiveStart}}|{{lineValueEnd}})[^\\r\\n])*",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          }
        },
        {
          "comment": "Rule 9: percent-percent not followed by { and the rest of its line are a diagram comment. Follows state.md#the-statement-context.",
          "name": "comment.line.percentage.mermaid",
          "match": "{{state-percent-comment}}",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          }
        }
      ]
    },
    "state-scale": {
      "comment": "Scale and whitespace enter the scale context, ASCII digits form a number, and whitespace followed by bounded width leaves it. Follows state.md#the-scale-context.",
      "match": "((?i:scale))({{state-required-padding}})([0-9]+)({{state-required-padding}})((?i:width)){{wordEnd}}",
      "captures": {
        "1": {
          "name": "keyword.control.mermaid"
        },
        "2": {
          "patterns": [
            {
              "include": "#directive"
            }
