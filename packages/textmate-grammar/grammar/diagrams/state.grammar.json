    "state-body": {
      "comment": "{ starts a composite body, } closes it, and its rules include comments, classDef, class, style, state, direction, notes, terminals, ids, descriptions, arrows, dividers and class separators. Root-only accessibility, click, scale and hide keywords are ids here. Follows state.md#the-composite-body-context.",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.block.begin.mermaid"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "keyword.operator.block.end.mermaid"
        }
      },
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Rule 1: whitespace other than line feed is read before comments, state statements and direction lines. Follows state.md#the-composite-body-context.",
          "match": "(?:(?!{{separatorCommentEnd}})[{{lws}}])+"
        },
        {
          "include": "#state-comments"
        },
        {
          "include": "#state-context-statements"
        },
        {
          "include": "#state-direction"
        },
        {
          "include": "#state-notes"
        },
        {
          "comment": "Rule 13: -- is a divider unit in a composite body. Follows state.md#the-composite-body-context.",
          "match": "--(?!{{directives}}>)",
          "name": "punctuation.separator.divider.mermaid"
        },
        {
          "include": "#state-units"
        }
      ]
    },
    "state-units": {
      "comment": "Read terminals, ids, descriptions, transition arrows and class separators. Follows state.md#states-and-transitions.",
      "patterns": [
        {
          "comment": "Read the terminal state reference in an id position. Follows state.md#states-and-transitions.",
          "match": "\\[\\*\\]",
          "name": "variable.mermaid"
        },
        {
          "comment": "Rule 25: --> is the transition arrow. Follows state.md#the-statement-context.",
          "match": "-->",
          "name": "keyword.operator.arrow.mermaid"
        },
        {
          "comment": "Rule 26: ::: is a class separator. Follows state.md#the-statement-context.",
          "match": ":::",
          "name": "punctuation.separator.class.mermaid"
        },
        {
          "include": "#state-description"
        },
        {
          "comment": "An id is a maximal run excluding colon, whitespace, line feed, hyphen and {; internal percent pairs end it and internal hashes are characters. Ids carry the element-name scope. Follows state.md#units-and-contexts.",
          "match": "(?:{{entity}}|(?!{{directiveStart}}|{{nonDirectivePercentPair}})[^:{{ws}}\\r\\n{\\-])+",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#directive"
                }
