{
  "variables": {
    "state-note-header": "((?i:note))({{state-required-padding}})((?i:left|right))({{spaceSeparator}})((?i:of)){{wordEnd}}(?:({{nonDirectivePercentPair}}(?:{{entity}}|{{directive}}|(?!{{directiveStart}})[^:{{ws}}\\r\\n-])*)({{state-required-padding}}))?({{state-value-padding}})((?:{{entity}}|(?!{{directives}}{{nonDirectivePercentPair}}|{{directiveStart}})[^:{{ws}}\\r\\n-])+|(?={{directives}}{{nonDirectivePercentPair}}))",
    "state-word": "[A-Za-z0-9_]+",
    "state-style-ids": "(?:{{state-word}}|,)(?:{{directives}}(?:{{state-word}}|,))*",
    "state-direction-head": "({{lineText}})(direction)({{state-required-padding}})",
    "state-percent-comment": "{{nonDirectivePercentPair}}(?!{{directives}}\\{)(?:{{directive}}|(?!{{directiveStart}}|{{lineValueEnd}})[^\\r\\n])*",
    "state-colon-or-semicolon-end": "(?=[:;]|$)",
    "state-direction-tail": "(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^\\r\\n])*",
    "state-value-padding": "(?:(?!{{separatorCommentEnd}})(?:[{{ws}}]|{{directive}}))*",
    "state-floating-id": "(?:{{entity}}|{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^\\r\\n])*",
    "state-required-padding": "(?={{requiredGap}}){{state-value-padding}}",
    "state-alias-end": "{{lineValueEnd}}|(?={{nonDirectivePercentPair}}|\\{)",
    "state-note-space": "(?!{{separatorCommentEnd}})[{{ws}}]",
    "state-style-value-end": "(?={{lineGap}}(?:,|$))|{{separatorCommentEnd}}"
  },
  "patterns": [
    {
      "include": "#state"
    }
  ],
  "repository": {
    "state": {
      "comment": "Detection.md entry 20: `stateDiagram`, exact. The lexer then reads the header again, case-insensitively and followed by whitespace. So `stateDiagram-V2` is a header. Follows state.md#detection.",
      "begin": "{{diagramStart}}(stateDiagram(?i:-v2)?)(?={{directives}}(?:[{{ws}}]|$))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "comment": "Rules 1 and 2: bounded click and href are keyword units; strings precede direction lines. Follows state.md#the-statement-context.",
          "match": "(?i:click|href){{wordEnd}}",
          "name": "keyword.control.mermaid"
        },
        {
          "include": "#state-string"
        },
        {
          "include": "#state-direction"
        },
        {
          "include": "#state-comments"
        },
        {
          "include": "#state-acc-descr-block"
        },
        {
          "include": "#state-accessibility-line"
        },
        {
          "include": "#state-scale"
        },
        {
          "comment": "Rule 21: hide empty description, with exactly one space between words and a final word boundary, is the hide, empty and description-word units. Follows state.md#the-statement-context.",
          "match": "((?i:hide))({{spaceSeparator}})((?i:empty))({{spaceSeparator}})((?i:description)){{wordEnd}}",
          "captures": {
            "1": {
              "name": "keyword.control.mermaid"
            },
            "2": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            },
            "3": {
              "name": "keyword.control.mermaid"
            },
            "4": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            },
            "5": {
              "name": "keyword.control.mermaid"
            }
          }
        },
        {
          "include": "#state-context-statements"
        },
        {
          "include": "#state-notes"
        },
        {
          "include": "#state-body"
        },
        {
          "include": "#state-units"
        }
      ]
    },
    "state-direction": {
      "comment": "TB, BT, RL and LR are tried in this order, at the last direction for that value; the surrounding runs are direction-text. directives inside direction-text join its parts; between direction and the value they are trivia. A directive is read whole, so its argument cannot supply direction or its value. Runs stop before separator-led common comments, and padding never consumes their separator. Follows state.md#the-statement-context and common.md#comment-lines.",
      "match": "(?i:{{state-direction-head}}(TB)({{state-direction-tail}})|{{state-direction-head}}(BT)({{state-direction-tail}})|{{state-direction-head}}(RL)({{state-direction-tail}})|{{state-direction-head}}(LR)({{state-direction-tail}}))",
      "captures": {
        "1": {
          "patterns": [
