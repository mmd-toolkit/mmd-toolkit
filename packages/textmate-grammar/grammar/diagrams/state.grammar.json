      "end": "({{lineText}})(?i:(<<fork>>))|({{lineText}})(?i:(<<join>>))|({{lineText}})(?i:(<<choice>>))|({{lineText}})(?i:(\\[\\[fork\\]\\]))|({{lineText}})(?i:(\\[\\[join\\]\\]))|({{lineText}})(?i:(\\[\\[choice\\]\\]))|$|(?=\\{)",
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#state-comments"
        },
        {
          "match": "\"\"",
          "name": "comment.block.ignored.mermaid",
          "comment": "Read an empty string in the state context as ignored text. Follows state.md#composite-states-aliases-and-pseudostates."
        },
        {
          "include": "#state-string"
        },
        {
          "comment": "Read an alias id and its optional description, retaining percent text before a same-line composite body as ignored text. Follows state.md#the-state-context and state.md#composite-states-aliases-and-pseudostates.",
          "begin": "((?i:as))({{state-required-padding}})",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.mermaid"
            },
            "2": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          },
          "end": "{{lineValueEnd}}|(?=\\{)|(?={{nonDirectivePercentPair}})(?!(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^\\r\\n{])*\\{)",
          "patterns": [
            {
              "include": "#directive"
            },
            {
              "comment": "Read ignored percent text before an alias body, leaving its brace for the composite context. Follows state.md#the-state-context and state.md#composite-states-aliases-and-pseudostates.",
              "match": "{{nonDirectivePercentPair}}(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}})[^{\\r\\n])*(?=\\{)",
              "name": "comment.block.ignored.mermaid",
              "captures": {
                "0": {
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ]
                }
              }
            },
            {
              "match": "(?:{{entity}}|{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}}|{{nonDirectivePercentPair}})[^{\\r\\n])+(?=\\{)",
              "captures": {
                "0": {
                  "name": "variable.mermaid",
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ]
                }
              },
              "comment": "Keep colons inside a composite alias's id. Follows state.md#the-state-context."
            },
            {
              "comment": "Divide only the first colon of an alias without a following body; directives and entity semicolons belong to text. Follows state.md#the-state-context.",
              "begin": ":(?!(?:{{directive}}|(?!{{directiveStart}}|{{nonDirectivePercentPair}})[^{\\r\\n])*\\{)",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.separator.colon.mermaid"
                }
              },
              "end": "{{state-alias-end}}",
              "patterns": [
                {
                  "include": "#directive"
                },
                {
                  "begin": ":",
                  "name": "comment.block.ignored.mermaid",
                  "end": "{{state-alias-end}}",
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ],
                  "comment": "Retain the suffix from the second colon as one ignored unit. Follows state.md#the-state-context."
                },
                {
                  "match": "(?:{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}}|{{nonDirectivePercentPair}})[^:{\\r\\n])+",
                  "name": "string.unquoted.mermaid",
                  "captures": {
                    "0": {
                      "patterns": [
                        {
                          "include": "#directive"
                        }
                      ]
                    }
                  },
                  "comment": "Read an alias's second description. Follows state.md#the-state-context."
                }
              ]
            },
            {
              "match": "(?:{{entity}}|{{directive}}|(?!{{directiveStart}}|{{separatorCommentEnd}}|{{nonDirectivePercentPair}})[^:{\\r\\n])+",
              "captures": {
                "0": {
                  "name": "variable.mermaid",
                  "patterns": [
                    {
                      "include": "#directive"
                    }
                  ]
                }
              },
              "comment": "Read the alias id before its description. Follows state.md#the-state-context."
            }
          ]
        },
        {
          "comment": "Rule 8: state-name is one or more characters other than line feed, whitespace and {; embedded percent pairs, quotes and keyword-like suffixes are name characters. Directives end a name run. Follows state.md#the-state-context.",
          "match": "(?:(?!{{directiveStart}})[^{{ws}}\\r\\n{])+",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ],
              "name": "variable.mermaid"
            }
          }
        }
      ],
      "endCaptures": {
        "1": {
