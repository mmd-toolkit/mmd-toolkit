    "state-declaration": {
      "comment": "Read state and its required whitespace before its names, alias, pseudostate or body. Follows state.md#the-statement-context.",
      "begin": "((?i:state))({{state-required-padding}})(?!{{state-value-padding}}\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
        },
