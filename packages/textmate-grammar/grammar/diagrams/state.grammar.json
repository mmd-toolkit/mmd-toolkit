        "5": {
          "name": "keyword.control.mermaid"
        }
      }
    },
    "state-context-statements": {
      "comment": "Rule 4: classDef, class, style and state precede the direction line in a composite body. Follows state.md#the-composite-body-context.",
      "patterns": [
        {
          "include": "#state-style"
        },
        {
          "include": "#state-class"
        },
        {
          "match": "((?i:state))({{state-required-padding}})(?=(?:\"\"{{state-value-padding}})*\\{)",
          "captures": {
            "1": {
              "name": "comment.block.ignored.mermaid"
            },
            "2": {
              "patterns": [
                {
                  "include": "#directive"
                }
              ]
            }
          },
          "comment": "Read state before a following body opener as ignored text. Follows state.md#the-statement-context."
        },
        {
          "include": "#state-declaration"
        }
      ]
    },
    "state-style": {
      "comment": "ClassDef reads one word class name and whitespace; style reads word characters and commas followed by whitespace; both then read comma-separated style-text to line end. Follows state.md#the-classdef-class-and-style-contexts.",
      "begin": "((?i:classDef))({{state-required-padding}})({{state-word}})({{state-required-padding}})|((?i:style))({{state-required-padding}})({{state-style-ids}})({{state-required-padding}})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mermaid"
        },
        "2": {
          "patterns": [
            {
              "include": "#directive"
            }
          ]
        },
        "3": {
          "name": "variable.mermaid"
