> flowchart %%{init: {}}%%>
  "flowchart" keyword.control.mermaid
  "%%{" meta.directive.mermaid keyword.operator.delimiter.directive.begin.mermaid
  "init" meta.directive.mermaid entity.name.function.directive.mermaid
  ":" meta.directive.mermaid keyword.operator.separator.colon.mermaid
  " " meta.directive.mermaid
  "{}" meta.directive.mermaid string.unquoted.directive.mermaid
  "}%%" meta.directive.mermaid keyword.operator.delimiter.directive.end.mermaid
  ">" constant.language.mermaid
> A[direction label]-->B
  "A" variable.mermaid
  "[" keyword.operator.shape.begin.mermaid
  "direction label" string.unquoted.mermaid
  "]" keyword.operator.shape.end.mermaid
  "-->" keyword.operator.arrow.mermaid
  "B" variable.mermaid
> 