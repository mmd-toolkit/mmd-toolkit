{
  "name": "mmdfmt",
  "version": "0.2.2",
  "description": "Formatter for Mermaid diagrams in .mmd files and in Markdown code blocks, which changes nothing else, as a command and as a function",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmd-toolkit/mmd-toolkit.git",
    "directory": "packages/mmdfmt"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ota-meshi"
  },
  "type": "module",
  "bin": {
    "mmdfmt": "./lib/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "keywords": [
    "mermaid",
    "mmd",
    "markdown",
    "formatter",
    "cli"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf lib",
    "test": "vitest run"
  },
  "dependencies": {
    "gunshi": "^0.37.3",
    "prettier": "^3.9.0",
    "prettier-plugin-mmd": "workspace:^",
    "tinyglobby": "^0.2.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
