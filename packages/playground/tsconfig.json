{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "isolatedDeclarations": false,
    "paths": {
      "@mmd-toolkit/parser": ["../parser/src/index.ts"],
      "prettier-plugin-mmd": ["../prettier-plugin-mmd/src/index.ts"],
      "@mmd-toolkit/textmate-grammar": ["../textmate-grammar/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "*.ts"],
  "exclude": ["lib", "node_modules"]
}
